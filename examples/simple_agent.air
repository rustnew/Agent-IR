// The "before" program of §13.1: three independent inspections the LLM emitted
// sequentially, feeding one profiling step.
//
// Nothing here says the three inspections must run in order — that ordering is
// an artefact of how the LLM wrote them down. `Parallelization` turns this into
// `simple_agent.parallelized.air`.
module @simple version(0) {
  capability @inspect scope("host") grants(read_external)

  agent.func "inspect_and_profile" {
  ^bb0(%model: !tool.ref<model>, %hardware: !tool.ref<hw>, %dataset: !tool.ref<dataset>):
    %model_info = agent.action "inspect_model"(%model) {effect = #pure} : !observation.observation<model>
    %hardware_info = agent.action "inspect_hardware"(%hardware) {effect = #pure} : !observation.observation<hw>
    %dataset_info = agent.action "inspect_dataset"(%dataset) {effect = #pure} : !observation.observation<dataset>
    %profile = agent.action "profile"(%model_info, %hardware_info, %dataset_info) {effect = #read_external<host>} : !observation.observation<profile>
    agent.return(%profile) {effect = #pure}
  } {effect = #pure}
}
